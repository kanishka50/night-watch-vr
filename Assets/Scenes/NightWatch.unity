    - name: The fence breaker
      side: 0
      adults: 1
      withCalf: 0
      fenceBreaker: 1
      villageSide: 0
    - name: The bull from the village side
      side: 2
      adults: 1
      withCalf: 0
      fenceBreaker: 0
      villageSide: 1
