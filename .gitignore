# Build output and crash files
*.apk
*.aab
*.app
*.unitypackage
*.unitypackage.meta
sysinfo.txt
mono_crash.*
crashlytics-build.properties

# Windows
Thumbs.db
Desktop.ini

# Made by the performance testing package during each build (not ours)
/Assets/Resources/PerformanceTestRun*
/Assets/Resources.meta
