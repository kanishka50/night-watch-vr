  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::StoryIntro
  play: 0
  scenes:
  - spot: {fileID: 390744998}
    text: 'A village in the dry zone of Sri Lanka.

      It is harvest time.'
    seconds: 8
    elephant: 0
  - spot: {fileID: 1734709386}
    text: 'The rice is ripe.

      A family''s whole year grows in this field.'
    seconds: 8
    elephant: 0
  - spot: {fileID: 1464569022}
    text: 'At night, wild elephants come out of the jungle.

      They are hungry,
      not cruel.'
    seconds: 11
    elephant: 1
  - spot: {fileID: 92378466}
    text: 'Tonight you keep watch from the pela,

      the farmer''s watch hut.'
    seconds: 8
    elephant: 0
  - spot: {fileID: 446519385}
    text: 'Keep everyone alive until dawn:

      you, your neighbour and the elephants.'
    seconds: 8
    elephant: 0
  leaf: {fileID: 1812260347}
  leafText: {fileID: 1369186390}
  startSpot: {fileID: 3517939}
  elephantModel: {fileID: 1066305670}
  elephantFrom: {x: -26, y: 0, z: -54}
  elephantTo: {x: 8, y: 0, z: -54}
  leafDistance: 1.8
  leafHeight: 1.45
  textFadeSeconds: 0.8
