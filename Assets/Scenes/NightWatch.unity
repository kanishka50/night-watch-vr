  m_Script: {fileID: 11500000, guid: 29842b7508ad62c48bfa33ebe81bca8a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::StoryIntro
  play: 0
  scenes:
  - spot: {fileID: 460603108}
    text: 'A village in the dry zone of Sri Lanka.

      It is harvest time.'
    seconds: 8
    elephant: 0
  - spot: {fileID: 2014744616}
    text: 'The rice is ripe.

      A family''s whole year grows in this field.'
    seconds: 8
    elephant: 0
  - spot: {fileID: 1292320261}
    text: 'At night, wild elephants come out of the jungle.

      They are hungry,
      not cruel.'
    seconds: 11
    elephant: 1
  - spot: {fileID: 93687728}
    text: 'Tonight you keep watch from the pela,

      the farmer''s watch hut.'
    seconds: 8
    elephant: 0
  - spot: {fileID: 1929511031}
    text: 'Keep everyone alive until dawn:

      you, your neighbour and the elephants.'
    seconds: 8
    elephant: 0
  leaf: {fileID: 749522620}
  leafText: {fileID: 1974993793}
  startSpot: {fileID: 1638061265}
  elephantModel: {fileID: 523448816}
  elephantFrom: {x: -26, y: 0, z: -54}
  elephantTo: {x: 8, y: 0, z: -54}
  leafDistance: 1.8
  leafHeight: 1.45
  textFadeSeconds: 0.8
