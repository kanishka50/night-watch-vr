  northSpawn: {fileID: 2131703771}
  southSpawn: {fileID: 1448666908}
  villageSpawn: {fileID: 1487404261}
  spawnSpread: 5
  tutorialTime: 10
  firstNightWaveDelay: 10
  gapAfterWave: 20
  maxWaveSeconds: 120
  tutorialWave:
    message: 'Look north: an elephant is coming to the fence. Watch what the fence
      does.'
    groups:
    - name: The bull at the fence
      side: 0
      adults: 1
      withCalf: 0
      fenceBreaker: 0
      villageSide: 0
  nightWaves:
  - message: 'Listen: branches are cracking somewhere. Look around.'
    groups:
    - name: A lone bull
      side: 1
      adults: 1
      withCalf: 0
      fenceBreaker: 0
      villageSide: 0
  - message: 'Listen: several elephants are moving. A herd is coming.'
    groups:
    - name: The herd
      side: 1
      adults: 2
      withCalf: 1
      fenceBreaker: 0
      villageSide: 0
  - message: Elephants on two sides! Check the fence AND the village side.
