  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::StoryIntro
  play: 0
  scenes:
  - spot: {fileID: 884223620}
    text: 'A village in the dry zone of Sri Lanka.

      It is harvest time.'
    seconds: 8
    elephant: 0
  - spot: {fileID: 192475915}
    text: 'The rice is ripe.

      A family''s whole year grows in this field.'
    seconds: 8
    elephant: 0
  - spot: {fileID: 341004634}
    text: 'At night, wild elephants come out of the jungle.

      They are hungry,
      not cruel.'
    seconds: 11
    elephant: 1
  - spot: {fileID: 533673314}
    text: 'Tonight you keep watch from the pela,

      the farmer''s watch hut.'
    seconds: 8
    elephant: 0
  - spot: {fileID: 1883891530}
    text: 'Keep everyone alive until dawn:

      you, your neighbour and the elephants.'
    seconds: 8
    elephant: 0
  leaf: {fileID: 1241908734}
  leafText: {fileID: 148040926}
  startSpot: {fileID: 1492867228}
  elephantModel: {fileID: 451695079}
