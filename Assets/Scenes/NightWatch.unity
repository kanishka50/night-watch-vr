  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::StoryIntro
  play: 0
  scenes:
  - spot: {fileID: 1397441106}
    text: 'A village in the dry zone of Sri Lanka.

      It is harvest time.'
    seconds: 8
    elephant: 0
  - spot: {fileID: 1821521690}
    text: 'The rice is ripe.

      A family''s whole year grows in this field.'
    seconds: 8
    elephant: 0
  - spot: {fileID: 1665463230}
    text: 'At night, wild elephants come out of the jungle.

      They are hungry,
      not cruel.'
    seconds: 11
    elephant: 1
  - spot: {fileID: 870201589}
    text: 'Tonight you keep watch from the pela,

      the farmer''s watch hut.'
    seconds: 8
    elephant: 0
  - spot: {fileID: 974171861}
    text: 'Keep everyone alive until dawn:

      you, your neighbour and the elephants.'
    seconds: 8
    elephant: 0
  leaf: {fileID: 105928271}
  leafText: {fileID: 345209182}
  startSpot: {fileID: 701930460}
  elephantModel: {fileID: 1571709027}
