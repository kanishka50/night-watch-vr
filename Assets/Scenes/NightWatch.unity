  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 752a9277665c28e4796a27efb1ed555f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ArrivalManager
  elephantTemplate: {fileID: 761994396}
  northSpawn: {fileID: 522049646}
  southSpawn: {fileID: 600332276}
  villageSpawn: {fileID: 1775605221}
  spawnSpread: 5
  tutorialTime: 10
  firstNightWaveDelay: 10
  gapAfterWave: 20
  maxWaveSeconds: 120
  tutorialWave:
    message: 'Look north: an elephant is coming to the fence. Watch what the fence
      does.'
    groups:
    - name: The bull at the fence
      side: 0
      adults: 1
      withCalf: 0
      fenceBreaker: 0
      villageSide: 0
  nightWaves:
  - message: 'Listen: branches are cracking somewhere. Look around.'
    groups:
    - name: A lone bull
      side: 1
      adults: 1
      withCalf: 0
      fenceBreaker: 0
      villageSide: 0
  - message: 'Listen: several elephants are moving. A herd is coming.'
    groups:
    - name: The herd
      side: 1
      adults: 2
      withCalf: 1
      fenceBreaker: 0
      villageSide: 0
  - message: Elephants on two sides! Check the fence AND the village side.
    groups:
    - name: The fence breaker
      side: 0
      adults: 1
      withCalf: 0
      fenceBreaker: 1
      villageSide: 0
    - name: The bull from the village side
      side: 2
      adults: 1
      withCalf: 0
      fenceBreaker: 0
      villageSide: 1
